# Copy to .env and fill in. Never commit the real .env.

# --- LLM (used for resume structuring, job scoring, and form fill-planning) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Aggregator APIs (optional, discovery still works without them) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

# --- Paths ---
JOBBOT_DATA_DIR=./data
# Used when config/resumes/ has no imported profiles (single-resume mode).
JOBBOT_RESUME_PATH=./data/resume.pdf
# Drop multiple resumes here (see `jobbot resume import-folder`) to have
# jobbot pick the best-fitting one per job instead of one resume for everything.
JOBBOT_RESUMES_DIR=./config/resumes

# --- Submission behavior ---
# Playwright runs headed (visible browser) by default so you can watch/intervene.
JOBBOT_HEADLESS=false
# Safety default: nothing is ever submitted without typing "yes" at the terminal
# prompt, regardless of this flag. See README "Guardrails" before changing.
JOBBOT_AUTO_SUBMIT=false
# Once a sensitive question (work authorization, EEOC, legal attestation,
# background/criminal history, ...) has been answered once, reuse that
# answer automatically instead of stopping for review every time. OFF by
# default. Turning this on still requires typing CONFIRM once per run,
# after jobbot shows you exactly which saved answers it's about to reuse —
# see README "Memory" and "Guardrails" before enabling.
JOBBOT_AUTOFILL_SENSITIVE=false
